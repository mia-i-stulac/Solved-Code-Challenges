# The Problem from Linkedin Learinng: Given this triangle function, make a square function using recursion and calls the triangle function, without multiplication or exponents. 

# This was the given one
def triangle(num):
    if num == 1:
        return num
    return num + triangle(num - 1)
    
# This is what I wrote
def square(num):
    return triangle(num) + triangle(num - 1) 
